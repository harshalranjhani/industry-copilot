# OpenRouter is the only LLM provider: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Default model for new conversations (must be in Pi's OpenRouter catalog)
# DEFAULT_MODEL=openai/gpt-6-luna

# Opt out of OpenUI's anonymous usage analytics
# OPENUI_TELEMETRY_DISABLED=1

# Dataset roots (each holds fleet/ and assets/); separate several with ":"; later roots win.
# Defaults to flytbase-ahc-swe-asset-intelligence-dataset/sample-data
# DATA_DIRS=
# "Today" for relative periods
# AS_OF=2026-10-17
# Where `pnpm load` writes the data store
# DATA_DB=.data/copilot.db
