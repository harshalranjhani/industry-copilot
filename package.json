{
  "name": "industry-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openui generate src/library.ts --no-telemetry --out src/generated/openui-prompt.txt",
    "predev": "pnpm generate",
    "dev": "next dev",
    "prebuild": "pnpm generate",
    "build": "next build",
    "start": "next start",
